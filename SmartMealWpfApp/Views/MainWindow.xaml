<Window x:Class="SmartMealWpfApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Тестовое WPF-приложение для SmartMealService"
        Width="1006"
        Height="439"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        >

    <Window.Resources>

        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#3B3B3B" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#22000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridCellBordersStyle" TargetType="Control">
            <Setter Property="BorderBrush" Value="#707070" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <Style x:Key="GridHeaderStyle_Left" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridCellBordersStyle}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#2E2E2E" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="GridHeaderStyle_Right" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle_Left}">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="GridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource GridCellBordersStyle}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Focusable" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFFDF6D8" />
                    <Setter Property="Foreground" Value="#2E2E2E" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridRowHeaderStyle" TargetType="DataGridRowHeader" BasedOn="{StaticResource GridCellBordersStyle}">
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="GridTextStyle" TargetType="FrameworkElement">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="3" />
        </Style>

        <Style x:Key="GridTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextStyle}">
        </Style>

        <Style x:Key="GridEditingTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource GridTextStyle}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Margin" Value="1 3 3 3" />
        </Style>

    </Window.Resources>

    <Grid Background="Transparent">
        <Border Margin="8,8,24,24"
                Background="White"
                CornerRadius="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  Direction="315"
                                  ShadowDepth="10"
                                  Opacity="0.18"
                                  Color="#000000" />
            </Border.Effect>

            <!-- WindowGrid -->
            <Grid>

                <!-- WidowContentGrid -->
                <Grid Margin="26 0 26 26">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- TitleGrid -->
                    <Grid Grid.Row="0"
                          Background="Transparent"
                      MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"
                      >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Bottom"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#404040"
                               Text="Тестовое WPF-приложение для SmartMealService" />

                        <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">

                            <!-- MinimizeButton -->
                            <Button Style="{StaticResource CaptionButtonStyle}"
                                    Click="MinimizeButton_Click">
                                <Path Data="M 0,6 L 18,6"
                                      Stretch="None" 
                                      Stroke="#333333" 
                                      StrokeThickness="5" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Button>
                            
                            <!-- CloseButton -->
                            <Button Style="{StaticResource CaptionButtonStyle}"
                                Margin="0"
                                Click="CloseButton_Click">
                                <Path Data="M 0,0 L 12,12 M 12,0 L 0,12" 
                                      Stretch="None" 
                                      Stroke="#333333" 
                                      StrokeThickness="5" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Button>
                            
                        </StackPanel>
                    </Grid>

                    <!-- TableGrid -->
                    <Grid Grid.Row="2">

                        <DataGrid x:Name="dg"
                            Margin="0"
                            
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="True"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="All"
                                  RowHeaderWidth="48"
                                  RowHeight="28"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle_Left}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  RowHeaderStyle="{StaticResource GridRowHeaderStyle}"
                                  RowEditEnding="VariablesGrid_RowEditEnding"
                                  ItemsSource="{Binding Variables}">

                            <DataGrid.Resources>

                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>

                                <!-- Переопределяем стиль кнопки в левом верхнем углу -->
                                <Style TargetType="Button" x:Key="{ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}"
                                       BasedOn="{StaticResource GridCellBordersStyle}">
                                    <Setter Property="Background" Value="White" />

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <!-- Поле -->
                                <DataGridTextColumn Header="Поле"
                                                    Binding="{Binding Name}"
                                                    Width="245"
                                                    IsReadOnly="True"
                                                    ElementStyle="{StaticResource GridTextBlockStyle}"
                                                    />

                                <!-- Значение -->
                                <DataGridTextColumn Header="Значение"
                                                    Binding="{Binding Value}"
                                                    Width="245"
                                                    ElementStyle="{StaticResource GridTextBlockStyle}"
                                                    EditingElementStyle="{StaticResource GridEditingTextBoxStyle}"
                                />

                                <!-- Комментарий -->
                                <DataGridTextColumn Header="Комментарий"
                                                    Binding="{Binding Comment}"
                                                    Width="*"
                                                    HeaderStyle="{StaticResource GridHeaderStyle_Right}"
                                                    ElementStyle="{StaticResource GridTextBlockStyle}"
                                                    EditingElementStyle="{StaticResource GridEditingTextBoxStyle}"
                                                    >
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border 
                            BorderBrush="#505050"
                            BorderThickness="2"
                            CornerRadius="26"
                            SnapsToDevicePixels="True">
                        </Border>

                    </Grid>

                </Grid>

            </Grid>

        </Border>
    </Grid>
</Window>
